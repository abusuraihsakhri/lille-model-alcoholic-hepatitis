{
  "openapi": "3.1.0",
  "info": {
    "title": "Lille Model Alcoholic Hepatitis API",
    "description": "Lille clinical calculator and supplementary operational audit endpoints. Clinical calculation follows Louvet et al. (2007).",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "Operational metrics JSON"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Air-gapped supervisory conversational assistant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/lille": {
      "post": {
        "summary": "Calculate a day-7 Lille response score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "age": {
                    "type": "integer"
                  },
                  "albumin_day0": {
                    "type": "number",
                    "description": "g/dL"
                  },
                  "bilirubin_day0": {
                    "type": "number",
                    "description": "mg/dL"
                  },
                  "bilirubin_day7": {
                    "type": "number",
                    "description": "mg/dL"
                  },
                  "creatinine": {
                    "type": "number",
                    "description": "mg/dL"
                  },
                  "pt_seconds": {
                    "type": "number"
                  },
                  "inr": {
                    "type": "number"
                  }
                },
                "required": [
                  "age",
                  "albumin_day0",
                  "bilirubin_day0",
                  "bilirubin_day7",
                  "creatinine"
                ],
                "description": "Exactly one of pt_seconds or inr is required."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lille score and response classification"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    }
  }
}
